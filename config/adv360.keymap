#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &kp C_VOLUME_DOWN                                                                                 &kp C_PREVIOUS   &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp F     &kp D      &kp B   &kp K_MUTE                                                                                        &kp PAUSE_BREAK  &kp J   &kp H   &kp U      &kp Y     &kp SEMI  &kp BSLH
&kp ESC    &kp A      &kp R     &kp S     &kp T      &kp G   &kp C_VOLUME_UP    &kp LGUI         &kp LALT                  &kp LCTRL             &kp RCTRL     &kp K_NEXT       &kp M   &kp N   &kp E      &kp I     &kp O     &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp P      &kp V                                       &kp F14                   &kp LS(LA(DOWN))                                     &kp K   &kp L   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE          &lt 7 BACKSPACE  &kp LG(LS(NUMBER_4))      &kp LS(LG(NUMBER_5))  &lt 4 RETURN  &lt 1 LSHIFT             &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        whatever {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            display-name = "Fn";
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans  &trans                                        &trans  &trans     &trans     &trans   &trans   &trans  &trans
&trans  &trans  &kp F24  &kp F23  &kp F22  &trans  &trans                                        &trans  &trans     &trans     &trans   &trans   &trans  &trans
&trans  &trans  &kp F21  &kp F20  &kp F19  &trans  &trans   &trans   &trans      &trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &kp F16  &kp F15  &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans                    &trans      &trans                  &trans     &trans     &trans   &trans   &trans  &trans
&trans  &trans  &trans   &trans   &trans           &kp F18  &kp F17  &trans      &trans  &trans  &trans             &trans     &trans   &trans   &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                                   &trans           &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &bootloader                                              &bootloader      &trans  &trans      &trans      &trans  &trans  &trans
&studio_unlock  &trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans      &bt BT_CLR  &trans      &stp STP_BAT     &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &macro_ver    &trans                             &trans      &trans                                   &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                      &trans       &trans  &trans      &trans      &bl BL_TOG  &rgb_ug RGB_TOG          &bl BL_INC  &bl BL_DEC  &trans  &trans  &trans
            >;
        };

        move_single {
            display-name = "Red";
            bindings = <
&trans  &trans  &trans        &trans        &trans         &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LS(TAB)   &kp UP        &kp TAB        &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT      &kp DOWN      &kp RIGHT      &trans  &trans    &trans   &trans      &trans  &trans  &trans  &trans  &mo 6   &mo 5   &trans  &trans  &trans
&trans  &trans  &kp LS(LEFT)  &kp LS(UP)    &kp LS(RIGHT)  &trans                     &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &kp LS(DOWN)  &trans                 &kp BSPC  &kp DEL  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        move_word {
            display-name = "Purple";
            bindings = <
&trans  &trans  &trans            &trans            &trans             &trans  &trans                                                 &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LS(TAB)       &kp LA(UP)        &kp TAB            &trans  &trans                                                 &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LA(LEFT)      &kp LA(DOWN)      &kp LA(RIGHT)      &trans  &trans        &trans       &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LS(LA(LEFT))  &kp LS(LA(UP))    &kp LS(LA(RIGHT))  &trans                             &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans            &kp LS(LA(DOWN))  &trans                     &kp LA(BSPC)  &kp LA(DEL)  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        move_line {
            display-name = "Cyan";
            bindings = <
&trans  &trans  &trans            &trans            &trans             &trans  &trans                                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LS(TAB)       &kp LG(UP)        &kp TAB            &trans  &trans                                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LG(LEFT)      &kp LG(DOWN)      &kp LG(RIGHT)      &trans  &trans             &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LS(LG(LEFT))  &kp LS(LG(UP))    &kp LS(LG(RIGHT))  &trans                                     &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans            &kp LS(LG(DOWN))  &trans                     &kp LG(BACKSPACE)  &kp LG(DELETE)  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        symbol {
            display-name = "Yellow";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans                 &trans  &trans   &trans          &trans            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans                 &trans  &trans   &kp LBKT        &kp RBKT          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                &trans                 &trans  &kp F22  &kp LEFT_BRACE  &kp RIGHT_BRACE   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                                               &trans  &trans   &kp LESS_THAN   &kp GREATER_THAN  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS          &trans   &trans          &trans            &trans  &trans
            >;
        };
    };
};
